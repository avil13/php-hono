  "fixtures": [
    {
      "id": "ordered-overlap",
      "feature": "C-01/C-02",
      "classification": "intentional-difference",
      "explanation": "PHP restores each handler's own path parameters after next(); upstream leaves the downstream route's parameters active.",
      "sourceTest": "src/hono.test.ts",
      "routes": [
        {
          "method": "USE",
          "path": "*",
          "kind": "trace",
          "value": "global"
        },
        {
          "method": "GET",
          "path": "/users/:id",
          "kind": "trace",
          "value": "dynamic"
        },
        {
          "method": "GET",
          "path": "/users/me",
          "kind": "text",
          "value": "me"
        }
      ],
      "requests": [
        {
          "method": "GET",
          "path": "/users/me"
        }
      ],
      "expected": [
        {
          "status": 200,
          "headers": {
            "content-type": "text/plain;charset=UTF-8"
          },
          "body": "me",
          "trace": [
            {
              "step": "global:before",
              "params": {}
            },
            {
              "step": "dynamic:before",
              "params": {
                "id": "me"
              }
            },
            {
              "step": "dynamic:after",
              "params": {}
            },
            {
              "step": "global:after",
              "params": {}
            }
          ]
        }
      ],
      "phpExpected": [
        {
          "status": 200,
          "headers": {
            "content-type": "text/plain;charset=UTF-8"
          },
          "body": "me",
          "trace": [
            {
              "step": "global:before",
              "params": {}
            },
            {
              "step": "dynamic:before",
              "params": {
                "id": "me"
              }
            },
            {
              "step": "dynamic:after",
              "params": {
                "id": "me"
              }
            },
            {
              "step": "global:after",
              "params": {}
            }
          ]
        }
      ]
    },
